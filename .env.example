# Premium checkout: card-to-card, approved by hand on Telegram (see README "Premium payments").
# Price in tomans (NEXT_PUBLIC_ so the create UI matches SSR). Each order adds 1 to 99 tomans
# so the owner can tell deposits apart; the buyer is shown the exact amount.
NEXT_PUBLIC_PREMIUM_PRICE_IRT=50000
# The card buyers pay into: 16 digits, and optionally the holder and bank shown next to it
PAYMENT_CARD=
# PAYMENT_CARD_HOLDER=
# PAYMENT_CARD_BANK=
# Telegram bot (from @BotFather) that asks you to approve each payment
TELEGRAM_BOT_TOKEN=
# Your own numeric chat id (message @userinfobot to see it); only you can approve
TELEGRAM_CHAT_ID=
# 16+ random characters (A-Z a-z 0-9 _ -); the same value is given to Telegram's setWebhook
TELEGRAM_WEBHOOK_SECRET=
# Orders are kept in Upstash Redis. On Vercel: add the Upstash Redis integration from the
# Marketplace; it sets KV_REST_API_URL / KV_REST_API_TOKEN, which are read as well.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# At least 32 random characters, e.g. `openssl rand -base64 48`
PAYMENT_TOKEN_SECRET=
# Optional: the site's public origin, used to make share-image / canonical URLs absolute for
# Telegram, WhatsApp, etc. Without it, Vercel's own production URL is used. See src/lib/site.ts.
# SITE_URL=https://example.ir

# Support and donations. All optional; whatever is empty is simply not shown.
# These are NEXT_PUBLIC_ (visible to every visitor on purpose), so set them in the
# hosting dashboard (e.g. Vercel → Settings → Environment Variables) or .env.local,
# and do not commit real values to this public repository.
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_CONTACT_TELEGRAM=
# NEXT_PUBLIC_CONTACT_INSTAGRAM=
# 16-digit card number; the donation section appears only when this is valid
# NEXT_PUBLIC_DONATION_CARD=
# Shown under the card number so donors can check the name in their bank app
# NEXT_PUBLIC_DONATION_HOLDER=
# NEXT_PUBLIC_DONATION_BANK=
