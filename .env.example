# Variza premium checkout — see src/features/payments/lib/config.ts
# Premium price in tomans (NEXT_PUBLIC_ so the create UI matches SSR)
NEXT_PUBLIC_PREMIUM_PRICE_IRT=50000
# Variza panel → profile → API key (shown only once; server-side only)
VARIZA_API_KEY=
# Variza profile → webhook secret. Also register <your origin>/api/payments/webhook
# as the callback URL in that profile, or creating a payment link fails with 422.
VARIZA_WEBHOOK_SECRET=
# Payment status shared between the webhook and the buyer's browser (Upstash Redis).
# On Vercel: add the Upstash Redis integration from the Marketplace; it sets
# KV_REST_API_URL / KV_REST_API_TOKEN, which are read as well.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# At least 32 random characters, e.g. `openssl rand -base64 48`
PAYMENT_TOKEN_SECRET=
# Optional: the site's public origin. Used for Variza's return URL (must be https) and to
# make share-image / canonical URLs absolute for Telegram, WhatsApp, etc.
# Without it, Vercel's own production URL is used. See src/lib/site.ts.
# SITE_URL=https://example.ir
