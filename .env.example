# Zarinpal premium checkout — see src/features/payments/lib/config.ts
# Premium price in tomans (NEXT_PUBLIC_ so the create UI matches SSR)
NEXT_PUBLIC_PREMIUM_PRICE_IRT=50000
# In sandbox mode any UUID works as the merchant id.
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=00000000-0000-4000-8000-000000000000
# At least 32 random characters, e.g. `openssl rand -base64 48`
PAYMENT_TOKEN_SECRET=
# Optional: the site's public origin. Used for the Zarinpal callback (must match the domain registered
# with Zarinpal) and to make share-image / canonical URLs absolute for Telegram, WhatsApp, etc.
# Without it, Vercel's own production URL is used. See src/lib/site.ts.
# SITE_URL=https://example.ir
